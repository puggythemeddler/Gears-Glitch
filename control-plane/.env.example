# Control Plane Database (separate Neon database)
CONTROL_PLANE_DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Control Plane API Key (generate a random string for auth)
CONTROL_PLANE_API_KEY=your-random-api-key-here

# Neon API Key (for creating client databases)
NEON_API_KEY=nkey_xxxxxxxxxx

# Render API Key (for creating client backends)
RENDER_API_KEY=rnd_xxxxxxxxxx

# Vercel Token (for creating client frontends; requires a personal access token)
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxx
# Vercel Team ID (optional — for team accounts; e.g. team_xxxxx)
VERCEL_TEAM_ID=

# Cloudflare (optional — for auto DNS setup)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Domain base for client subdomains
DOMAIN_BASE=gearglitch.com

# Your GitHub repo (for Vercel deployments)
FRONTEND_GIT_REPO=puggythemeddler/Gears-Glitch

# Slack webhook URL for down-client alerting (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# SMTP / Email (optional — can also be set via Settings tab in the UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=noreply@gearglitch.com
FROM_NAME=Gear&Glitch

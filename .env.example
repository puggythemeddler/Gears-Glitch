# ── Server ────────────────────────────────────────────────
PORT=8020
NODE_ENV=development

# Public URL of this server (used in email links — no trailing slash)
BASE_URL=http://localhost:8020

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (e.g. Neon, Railway, Supabase, local)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Security ──────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Secret shared with the multi-tenant control plane (min 16 chars).
# Enables remote management (plan sync, invoices, suspend/resume).
# Leave blank to disable all control-plane access to this server.
CONTROL_PLANE_SECRET=

# ── Admin Seed Credentials (auto-created on first run) ────
# Change these immediately after first login!
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gearandglitch.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Technician Seed Credentials ───────────────────────────
TECH_USERNAME=technician
TECH_EMAIL=tech@gearandglitch.com
TECH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Email / SMTP ──────────────────────────────────────────
# Leave SMTP_HOST blank to skip real email (logs to data/emails.log instead)
SMTP_HOST=
SMTP_PORT=587
# Set SMTP_SECURE=1 to use TLS (port 465); leave 0 for STARTTLS (port 587)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

FROM_EMAIL=no-reply@yourstore.com
SITE_NAME=Your Store Name

# ── WhatsApp Business API ─────────────────────────────────
# Meta WhatsApp Cloud API credentials (can also be set in admin UI)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Google OAuth ──────────────────────────────────────────
# Create a Web application OAuth 2.0 Client ID at:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

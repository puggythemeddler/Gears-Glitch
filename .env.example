# ── Server ────────────────────────────────────────────────
PORT=8020
NODE_ENV=development

# Public URL of this server (used in email links — no trailing slash)
BASE_URL=http://localhost:8020

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (e.g. Neon, Railway, Supabase, local)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Security ──────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Optional: dedicated key for encrypting secrets at rest (provider credentials,
# OAuth refresh tokens, M-Pesa/WhatsApp secrets). Must be >= 16 chars, stable,
# and never shared across unrelated deployments. Generate with:
#   openssl rand -hex 32
# If blank, secrets are encrypted with a key derived from JWT_SECRET (a strong
# JWT_SECRET is still required). Set ENCRYPTION_KEY if you plan to rotate
# JWT_SECRET independently.
ENCRYPTION_KEY=

# Secret shared with the multi-tenant control plane (min 16 chars).
# Enables remote management (plan sync, invoices, suspend/resume).
# Leave blank to disable all control-plane access to this server.
CONTROL_PLANE_SECRET=

# Public URL of the control plane (e.g. https://control-plane.onrender.com).
# Used to push client-created plans marked "sync to other clients" back to
# the control plane, which then distributes them to the other clients.
# Also enables the heartbeat reporter (used by the control-plane Ops Center).
# Leave blank to disable plan sync-up to the control plane and heartbeats.
CONTROL_PLANE_URL=

# How often the heartbeat reporter pushes a snapshot to the control plane
# (used for health/availability + config-drift detection in the Ops Center).
# Default 2 minutes; minimum 0.25.
HEARTBEAT_INTERVAL_MIN=2

# ── Rate limiting ──────────────────────────────────────────
# All /api requests are capped per IP. Defaults: 200 requests / 15 minutes.
# One storefront page load issues ~24 API calls and an admin view ~19, so raise
# API_RATE_MAX when the app sits behind carrier-grade NAT (many mobile users
# share one public IP) or when staff hit 429s during busy periods.
# API_RATE_MAX=200
# API_RATE_WINDOW_MIN=15

# ── Admin Seed Credentials (auto-created on first run) ────
# ADMIN_PASSWORD is used to CREATE the admin account when it does not exist.
# It is not re-applied on later boots — once the admin exists, changing or
# removing this var never resets that admin's password.
# In production, leave it set for the first boot, then rotate the password
# in the app as needed.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gearandglitch.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Technician Seed Credentials ───────────────────────────
TECH_USERNAME=technician
TECH_EMAIL=tech@gearandglitch.com
TECH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Email / SMTP ──────────────────────────────────────────
# Leave SMTP_HOST blank to skip real email (logs to data/emails.log instead)
SMTP_HOST=
SMTP_PORT=587
# Set SMTP_SECURE=1 to use TLS (port 465); leave 0 for STARTTLS (port 587)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

FROM_EMAIL=no-reply@yourstore.com
SITE_NAME=Your Store Name

# ── WhatsApp Business API ─────────────────────────────────
# Meta WhatsApp Cloud API credentials (can also be set in admin UI)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── M-Pesa (Daraja API) ───────────────────────────────────
# M-Pesa credentials. These are used as fallbacks — the same values
# can be set in Admin → Settings → Payments and are persisted to the
# database (mpesa_config), which takes precedence on server restart.
# Test with sandbox credentials first, then switch MPESA_ENV=production.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Paybill / store number for STK push (default sandbox shortcode)
MPESA_SHORTCODE=174379
# Till number (optional, only if using a buy goods till)
MPESA_TILL_NUMBER=
# "sandbox" or "production"
MPESA_ENV=sandbox
# Public, Safaricom-reachable HTTPS endpoint used as the STK callback base URL.
# Defaults to BASE_URL (then the request's own host). Set this explicitly in
# production so the callback never depends on a request-derived host:
# MPESA_CALLBACK_URL=https://your-store-domain.com

# ── Google OAuth ──────────────────────────────────────────
# Create a Web application OAuth 2.0 Client ID at:
# https://console.cloud.google.com/apis/credentials
# The server exchanges the authorization code server-side (never shown in the
# browser), so a client secret is required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the "Authorized redirect URI" registered for the client
# above, e.g. https://your-domain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── Gmail sending (optional) ──────────────────────────────
# Connect a Google account in Admin → Integrations → Gmail to send transactional
# email (order confirmations, notifications) through that account's Gmail.
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above. The OAuth callback is
# derived from BASE_URL (/api/integrations/gmail/callback); register it as an
# authorized redirect URI. Override only if you must point it elsewhere:
# GMAIL_OAUTH_REDIRECT_URI=
# Whitelisted scope used: https://www.googleapis.com/auth/gmail.send (send-only,
# no read of the mailbox). The refresh token is encrypted at rest (ENCRYPTION_KEY
# or JWT_SECRET-derived key) and never returned by any API.
